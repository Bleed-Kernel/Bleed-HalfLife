diff --git a/engine/common/filesystem_engine.c b/engine/common/filesystem_engine.c
index 9ed62eb2..66757ee4 100644
--- a/engine/common/filesystem_engine.c
+++ b/engine/common/filesystem_engine.c
@@ -26,6 +26,9 @@ GNU General Public License for more details.
 #include "common.h"
 #include "library.h"
 #include "platform/platform.h"
+#if XASH_BLEED
+#include <bleed/syscalls.h>
+#endif
 
 #if XASH_WIN32
 #include <direct.h>
@@ -314,6 +317,29 @@ static qboolean FS_DetermineRootDirectory( char *out, size_t size )
 	Sys_Error( "couldn't determine current directory: %s", SDL_GetError( ));
 #endif // !( XASH_POSIX || XASH_WIN32 )
 	return false;
+#elif XASH_BLEED
+	// the desktop starts programs in /, so try next to the binary before the nvme disk,
+	// otherwise a copy on a usb stick opened from Cabinet never finds its valve folder
+	string gamedir;
+	char *slash;
+
+	if( getcwd( out, size ))
+	{
+		Q_snprintf( gamedir, sizeof( gamedir ), "%s/%s", out, host.default_gamedir );
+		if( !access( gamedir, F_OK ))
+			return true;
+	}
+
+	if( _taskpath( (uint64_t)getpid( ), out, size ) == 0 && ( slash = Q_strrchr( out, '/' )) != NULL )
+	{
+		*slash = '\0';
+		Q_snprintf( gamedir, sizeof( gamedir ), "%s/%s", out, host.default_gamedir );
+		if( !access( gamedir, F_OK ))
+			return true;
+	}
+
+	Q_strncpy( out, "/initrd/halflife", size );
+	return true;
 #else // generic case
 	if( getcwd( out, size ))
 		return true;
diff --git a/engine/common/net_ws.c b/engine/common/net_ws.c
index d139dff7..3253d89d 100644
--- a/engine/common/net_ws.c
+++ b/engine/common/net_ws.c
@@ -310,6 +310,21 @@ static int NET_ThreadStart( void *ununsed )
 	NET_ResolveThread();
 	return 0;
 }
+#elif XASH_BLEED
+// no threads on bleed, starting one always fails so names get looked up in place
+#define mutex_create( x )     (( x ) = 0 )
+#define mutex_destroy( x )    (( void )( x ))
+#define mutex_lock( x )       (( void )( x ))
+#define mutex_unlock( x )     (( void )( x ))
+#define create_thread( thread, pfn ) (( thread ) = 0, ( void )( pfn ), 0 )
+#define detach_thread( x )    (( void )( x ))
+typedef int mutex_t;
+typedef int thread_t;
+static void *NET_ThreadStart( void *unused )
+{
+	NET_ResolveThread();
+	return NULL;
+}
 #elif !XASH_WIN32
 #include <pthread.h>
 #define mutex_create( x )     pthread_mutex_init( &( x ), NULL )
diff --git a/engine/common/whereami.c b/engine/common/whereami.c
index 3eb3f086..dc94d0a1 100644
--- a/engine/common/whereami.c
+++ b/engine/common/whereami.c
@@ -839,6 +839,49 @@ int WAI_PREFIX(getModulePath)(char* out, int capacity, int* dirname_length)
   return -1;
 }
 
+#elif defined(__bleed__)
+
+#include <unistd.h>
+#include <string.h>
+#include <limits.h>
+#include <bleed/syscalls.h>
+
+WAI_FUNCSPEC
+int WAI_PREFIX(getExecutablePath)(char* out, int capacity, int* dirname_length)
+{
+  char buffer[PATH_MAX];
+  int length, i;
+
+  if (_taskpath((uint64_t)getpid(), buffer, sizeof(buffer)) != 0)
+    return -1;
+
+  length = (int)strlen(buffer);
+  if (length <= capacity)
+  {
+    memcpy(out, buffer, length);
+
+    if (dirname_length)
+    {
+      for (i = length - 1; i >= 0; --i)
+      {
+        if (out[i] == '/')
+        {
+          *dirname_length = i;
+          break;
+        }
+      }
+    }
+  }
+
+  return length;
+}
+
+WAI_FUNCSPEC
+int WAI_PREFIX(getModulePath)(char* out, int capacity, int* dirname_length)
+{
+  return WAI_PREFIX(getExecutablePath)(out, capacity, dirname_length);
+}
+
 #elif defined(__SWITCH__) || defined(__vita__) || defined(__EMSCRIPTEN__)
 
 /* Not possible on this platform */
